OPENAI_API_KEY=sk-...
# Optional: override the Realtime model if your account uses a different id (e.g. gpt-realtime).
OPENAI_REALTIME_MODEL=gpt-realtime-2
# Optional: customer voice (sage, coral, shimmer, alloy, marin, cedar, verse...).
OPENAI_REALTIME_VOICE=sage
# Optional: speech speed multiplier (0.25-1.5). Default 1.1.
OPENAI_REALTIME_SPEED=1.1
# Optional: set to 1 to use real photos from /public/rooms/<slug>.jpg|webp.
NEXT_PUBLIC_USE_ROOM_IMAGES=1

# Postgres (Neon / Vercel Postgres / Supabase).
# DATABASE_URL = pooled connection (used at runtime).
# DATABASE_URL_UNPOOLED = direct connection (used by prisma db push / migrations).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/db?sslmode=require&pgbouncer=true"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/db?sslmode=require"

NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_PIN=2468
