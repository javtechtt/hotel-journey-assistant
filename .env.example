OPENAI_API_KEY=sk-...
# Optional: override the Realtime model if your account uses a different id
# (e.g. gpt-realtime). Defaults to gpt-realtime-2.
OPENAI_REALTIME_MODEL=gpt-realtime-2
# Optional: customer voice (sage, coral, shimmer, alloy, marin, cedar, verse...).
OPENAI_REALTIME_VOICE=sage
# Optional: speech speed multiplier (0.25-1.5). Default 1.1 (a touch faster).
OPENAI_REALTIME_SPEED=1.1
# Optional: set to 1 to use real photos from /public/rooms/<slug>.jpg.
NEXT_PUBLIC_USE_ROOM_IMAGES=0
DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_PIN=2468
